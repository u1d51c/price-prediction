# Шаблон секретов. Скопируйте в .env и заполните своими ключами.
# .env находится в .gitignore и НЕ должен попадать в репозиторий.

# NewsAPI (https://newsapi.org/) — бесплатный план: 100 запросов/день, окно — 30 дней
NEWSAPI_KEY=

# Reddit API (https://www.reddit.com/prefs/apps) — нужен для PRAW
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hse-yp/0.1 by u/your_username

# Alpha Vantage — News & Sentiment endpoint (бесплатный план: 25 запросов/день)
ALPHAVANTAGE_KEY=

# GDELT 2.0 — ключ НЕ требуется, всё открыто.
